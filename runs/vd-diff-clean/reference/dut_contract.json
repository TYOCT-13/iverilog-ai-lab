{
  "clock": {
    "edge": "posedge",
    "period_ns": 10.0,
    "signal": "clk"
  },
  "module": "mod10_counter",
  "ports": [
    {
      "direction": "input",
      "name": "clk",
      "signed": false,
      "width": 1
    },
    {
      "direction": "input",
      "name": "rst_n",
      "signed": false,
      "width": 1
    },
    {
      "direction": "input",
      "name": "enable",
      "signed": false,
      "width": 1
    },
    {
      "direction": "output",
      "name": "count",
      "signed": false,
      "width": 4
    }
  ],
  "reset": {
    "active_level": 0,
    "assert_cycles": 2,
    "signal": "rst_n",
    "synchronous": false
  }
}
