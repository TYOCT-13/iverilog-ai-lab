{
  "module": "mod10_counter",
  "ports": [
    {
      "name": "clk",
      "direction": "input",
      "width": 1,
      "signed": false
    },
    {
      "name": "rst_n",
      "direction": "input",
      "width": 1,
      "signed": false
    },
    {
      "name": "enable",
      "direction": "input",
      "width": 1,
      "signed": false
    },
    {
      "name": "count",
      "direction": "output",
      "width": 4,
      "signed": false
    }
  ],
  "clock": {
    "signal": "clk",
    "period_ns": 10.0,
    "edge": "posedge"
  },
  "reset": {
    "signal": "rst_n",
    "active_level": 0,
    "synchronous": false,
    "assert_cycles": 2
  }
}
