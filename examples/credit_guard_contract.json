{
  "module": "credit_guard",
  "ports": [
    {"name": "clk", "direction": "input", "width": 1},
    {"name": "rst_n", "direction": "input", "width": 1},
    {"name": "acquire", "direction": "input", "width": 1},
    {"name": "release_req", "direction": "input", "width": 1},
    {"name": "credits", "direction": "output", "width": 3}
  ],
  "clock": {"signal": "clk", "period_ns": 10, "edge": "posedge"},
  "reset": {"signal": "rst_n", "active_level": 0, "synchronous": false, "assert_cycles": 2},
  "parameters": {}
}
